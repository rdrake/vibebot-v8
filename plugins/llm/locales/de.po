#: plugin.py:379
msgid "Code generated (%d lines): %s"
msgstr "Code generiert (%d Zeilen): %s"

#: plugin.py:459
msgid "Error clearing context."
msgstr "Fehler beim Löschen des Kontexts."

#: service.py:334
msgid "Prompt cannot be empty"
msgstr "Eingabe darf nicht leer sein"

#: service.py:338
msgid "Prompt too long (max %d characters)"
msgstr "Eingabe zu lang (max. %d Zeichen)"

#: service.py:427
msgid "Error: %s timed out. Try again or simplify your request."
msgstr "Fehler: %s Zeitüberschreitung. Versuchen Sie es erneut oder vereinfachen Sie Ihre Anfrage."

#: service.py:431
msgid "Error: API rate limit reached. Please wait a few minutes and try again."
msgstr "Fehler: API-Ratenlimit erreicht. Bitte warten Sie einige Minuten und versuchen Sie es erneut."

#: service.py:433
msgid "Error: Invalid API key for %s. Please check your configuration."
msgstr "Fehler: Ungültiger API-Schlüssel für %s. Bitte überprüfen Sie Ihre Konfiguration."

#: service.py:435
msgid "Error: Content violates AI safety policies. Please rephrase your request."
msgstr "Fehler: Inhalt verstößt gegen KI-Sicherheitsrichtlinien. Bitte formulieren Sie Ihre Anfrage um."

#: service.py:439
msgid "Error: API returned an error. Check logs for details."
msgstr "Fehler: API hat einen Fehler zurückgegeben. Überprüfen Sie die Logs für Details."

#: service.py:445
msgid "Error: Unable to complete %s. Check your configuration or try again later."
msgstr "Fehler: %s konnte nicht abgeschlossen werden. Überprüfen Sie Ihre Konfiguration oder versuchen Sie es später erneut."

#: service.py:482 service.py:558
msgid "Error: %s"
msgstr "Fehler: %s"

#: service.py:500
msgid "Error: API key not configured for %s command"
msgstr "Fehler: API-Schlüssel für %s-Befehl nicht konfiguriert"

#: service.py:566
msgid "Error: API key not configured for draw command"
msgstr "Fehler: API-Schlüssel für draw-Befehl nicht konfiguriert"

#: service.py:593
msgid "Error: Failed to save generated image"
msgstr "Fehler: Generiertes Bild konnte nicht gespeichert werden"

#: service.py:616
msgid ""
"Error: No image generated. The prompt may have been blocked by content "
"safety filters. Try rephrasing your request."
msgstr ""
"Fehler: Kein Bild generiert. Die Eingabe wurde möglicherweise von "
"Sicherheitsfiltern blockiert. Versuchen Sie, Ihre Anfrage umzuformulieren."

